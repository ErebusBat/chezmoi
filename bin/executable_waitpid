#!/usr/bin/env zsh
# vim: set ft=zsh ts=2 sw=2 sts=2 et ai si sta:

# Wait for a PID, or all current processes with an exact matching name.
if (( $# != 1 )) || [[ "$1" == -* || -z "$1" ]]; then
  print -u2 -- "Usage: waitpid <pid|process-name>"
  exit 1
fi

typeset -a pids
if [[ "$1" == <-> ]]; then
  if (( $1 == 0 )); then
    print -u2 -- "PID must be greater than zero."
    exit 1
  fi
  pids=("$1")
else
  pids=( ${(f)"$(pgrep -x -- "$1")"} )
fi

found=0
for pid in $pids; do
  [[ "$pid" == $$ ]] && continue
  command_line=$(ps -p "$pid" -o command=) || continue
  print -r -- "Found pid#$pid: $command_line"
  found=1
done

if (( ! found )); then
  print -u2 -- "No running process found: $1"
  exit 1
fi

for pid in $pids; do
  [[ "$pid" == $$ ]] && continue
  while process_state=$(ps -p "$pid" -o stat=); do
    # A zombie has already terminated, even if its parent hasn't reaped it.
    [[ "$process_state" == *Z* ]] && break
    sleep 1
  done
done
