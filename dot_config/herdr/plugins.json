    "platforms": [
      "linux",
      "macos"
    ],
    "actions": [
      {
        "id": "open",
        "title": "Open bar",
        "description": "Fuzzy-jump to any tab or agent",
        "contexts": [
          "global"
        ],
        "command": [
          "sh",
          "-c",
          "herdr_bin=\"${HERDR_BIN_PATH:-herdr}\"; [ -x \"$herdr_bin\" ] || herdr_bin=herdr; exec \"$herdr_bin\" plugin pane open --plugin herdr-bar --entrypoint bar --placement popup"
