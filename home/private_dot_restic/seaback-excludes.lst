# SeaBack: caches, reproducible outputs, and selected unreadable service state.
# Keep .git, Downloads, Photos, Mail, Messages and other personal/app data.
# iCloud Drive and app documents are intentionally excluded; retained in iCloud.
$HOME/Library/Mobile Documents
**/.DS_Store
**/.Trash/**
**/node_modules/**
**/.venv/**
**/__pycache__/**
**/.pytest_cache/**
**/.mypy_cache/**
**/.ruff_cache/**
**/.next/**
**/.nuxt/**
**/.turbo/**
**/.build/**
**/.zig-cache/**
**/CMakeFiles/**
$HOME/.cache/**
# Caddy-managed TLS certificates and housekeeping state are not user-readable.
$HOME/.local/share/caddy/certificates
$HOME/.local/share/caddy/last_clean.json
# Root-owned editor undo history and disposable macOS provider/speech state.
$HOME/.local/state/nvim/undo/%private%etc%sudoers.d%home-ssh-tunnel.tmp
$HOME/Library/Application Support/FileProvider/*/wharf/tombstone
$HOME/Library/Group Containers/group.com.apple.CoreSpeech/Caches
# Root-owned macOS Control Center preferences are not user-readable.
$HOME/Library/Group Containers/group.com.apple.secure-control-center-preferences/Library/Preferences/group.com.apple.secure-control-center-preferences.av.plist
$HOME/.npm/_cacache/**
$HOME/.cargo/registry/**
$HOME/.cargo/git/**
$HOME/Library/Caches/**
$HOME/Library/Developer/Xcode/DerivedData/**
$HOME/Library/Logs/restic-seaback/**
$HOME/.restic/seaback/state/**
$HOME/Library/Application Support/*/Cache/**
$HOME/Library/Application Support/*/Caches/**
$HOME/Library/Application Support/*/Code Cache/**
$HOME/Library/Application Support/Google/Chrome/*/Cache/**
$HOME/Library/Application Support/Google/Chrome/*/Code Cache/**
$HOME/src/**/target/debug/**
$HOME/src/**/target/release/**
