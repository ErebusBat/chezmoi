#!/bin/zsh
# Usage: omp-acp [PROFILE] [ACP arguments...]
# Keep stdout clear for ACP protocol traffic.
# PROFILE defaults to "personal" so ACP clients (T3 Code) can launch us with no arguments.
omp_profile=personal
if (( $# > 0 )) && [[ -n "$1" && "$1" != -* ]]; then
  omp_profile="$1"
  shift
fi
case "$omp_profile" in
  personal)
    if [[ -f "$HOME/.config/erebusbat/agent-personal-api-keys.sh" ]]; then
      source "$HOME/.config/erebusbat/agent-personal-api-keys.sh" >&2
    fi
    if [[ "$OMP_VICTORIAMETRICS_OTLP_METRICS_ENDPOINT" != disabled && -f "$HOME/.omp/victoriametrics-otel.env" ]]; then
      source "$HOME/.omp/victoriametrics-otel.env" >&2
    fi
    ;;
  upserve)
    unset OCP_PROFILE OPENAI_API_KEY
    ;;
esac
# omp's CLI is a Bun script, and ACP clients (T3 Code's server on Linux) launch us with a
# minimal PATH. Put Bun/omp back on PATH before resolving the binary.
for dir in "$HOME/.local/share/mise/shims" "$HOME/.bun/bin"; do
  [[ -d "$dir" ]] && path=("$dir" $path)
done
typeset -U path
export PATH
exec omp "--profile=$omp_profile" acp "$@"
