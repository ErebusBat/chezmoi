{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "~/src/lshq/**": "allow",
      "~/src/erebusbat/**": "allow",
      "~/.local/share/mise/installs/ruby/**": "allow",
      "~/.rbenv/**": "allow",
      "/tmp/**": "allow",
      "/var/folders/**": "allow"
    }
  },
  "disabled_providers": [
    "openai",
    "anthropic",
    "google",
    "opencode"
  ],
  "share": "disabled",
  "experimental": {
    "disable_paste_summary": true
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "enabled": true
    },
    "opensearch-staging": {
      "type": "local",
      "command": [
        "/Users/andrew.burns/bin/.mcp-opensearch.sh",
        "staging"
      ]
    },
    "opensearch-prod": {
      "type": "local",
      "command": [
        "/Users/andrew.burns/bin/.mcp-opensearch.sh",
        "production"
      ]
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.us5.datadoghq.com/v1/mcp",
      "oauth": {}
    },
    "obsidian": {
      "type": "local",
      "command": [
        "/Users/andrew.burns/bin/.mcp-obsidian.sh"
      ]
    },
    "memory": {
      "type": "local",
      "command": [
        "/Users/andrew.burns/bin/.mcp-memory.sh"
      ]
    },
    "honeybadger": {
      "type": "remote",
      "url": "https://mcp.honeybadger.io/mcp"
    },
    "todoist": {
      "type": "local",
      "command": [
        "/Users/andrew.burns/bin/.mcp-todoist.sh"
      ]
    }
  },
  "providers": {
    "lmstudio": {
      "name": "LM Studio-compatible (llama.cpp)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen38": {
          "name": "Qwen3.8 27B Q6 (SeaBack)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": {
              "supported": true
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content",
            "maxTokensField": "max_tokens"
          },
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  },
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      },
      "models": {
        "gpt-5.2": {
          "name": "GPT 5.2 (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "reasoningEffort": "none",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
